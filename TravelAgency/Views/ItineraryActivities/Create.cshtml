@model TravelAgency.Domain.Models.ItineraryActivity

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>ItineraryActivity</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TravelActivityId"  class="control-label">TravelActivity</label>
                <select asp-for="TravelActivityId" class ="form-control" asp-items="ViewBag.TravelActivities">
                    <option selected value="0">---SelectActivity---</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="ItineraryId"  class="control-label">Itinerary</label>
                <select asp-for="ItineraryId" class="form-control" asp-items="ViewBag.Itineraryies">
                    <option selected value="0">---SelectItinerary---</option>
                </select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
