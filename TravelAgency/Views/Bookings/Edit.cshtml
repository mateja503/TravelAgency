@using TravelAgency.Domain.Shared
@model TravelAgency.Domain.Models.Booking

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>Booking</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            @* <div class="form-group">
                <label class="control-label">Customer</label>
                <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.Customers"></select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label class="control-label">FullName</label>
                <select asp-for="ItineraryId" class="form-control" asp-items="ViewBag.Itineraries"></select>
                <span asp-validation-for="ItineraryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Capacity" class="control-label"></label>
                <input asp-for="Capacity" class="form-control" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateRange.From" class="control-label"></label>
                <input asp-for="DateRange.From" type="date" class="form-control" />
                <span asp-validation-for="DateRange.From" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateRange.To" class="control-label"></label>
                <input asp-for="DateRange.To" type="date" class="form-control" />
                <span asp-validation-for="DateRange.To" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<BookingStatus>()"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
